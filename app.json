{
  "expo": {
    "name": "KnowSnout",
    "slug": "knowsnout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "knowsnout",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.knowsnout.app",
      "infoPlist": {
        "NSCameraUsageDescription": "KnowSnout needs the camera for food labels, pet photos, Stories posts, and contests.",
        "NSPhotoLibraryUsageDescription": "KnowSnout needs photo library access for food labels, avatars, Stories, and contests.",
        "NSPhotoLibraryAddUsageDescription": "KnowSnout може зберегти фото з логотипом у твою галерею, коли ти натиснеш «Скачати»."
      }
    },
    "android": {
      "package": "com.knowsnout.app",
      "adaptiveIcon": {
        "backgroundColor": "#122A4C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#122A4C",
          "defaultChannel": "vaccines"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "KnowSnout може додати нагадування про щеплення у твій календар (наприклад Google), якщо ти цього захочеш."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KnowSnout to use the camera for labels, pet photos, posts, and contests.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KnowSnout to access your photos to upload pet food labels."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "KnowSnout потрібен доступ до галереї для фото улюбленців, Stories і конкурсів.",
          "savePhotosPermission": "KnowSnout може зберегти фото з логотипом у твою галерею.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#122A4C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-after-eas-init"
      }
    }
  }
}
