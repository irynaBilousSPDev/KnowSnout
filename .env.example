# Copy to .env and fill in values from Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Set to true to skip Edge Function / OpenAI and return fixture JSON (recommended while building UI)
EXPO_PUBLIC_USE_MOCK_AI=true

# Optional: force demo auth + local history even if Supabase URL is set
# EXPO_PUBLIC_DEMO_MODE=false
